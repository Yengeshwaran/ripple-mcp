# Ripple voice service — copy to .env and fill in. Never commit .env.

# Server
VOICE_SERVICE_PORT=8002

# Upload limits — agreed demo limits, shared with the frontend (apps/web)
# Maximum file size in MB
MAX_UPLOAD_MB=25
# Maximum recording length in seconds (180 = 3 minutes). 0 disables the check.
MAX_AUDIO_SECONDS=180

# AssemblyAI (transcription + speaker diarization)
ASSEMBLYAI_API_KEY=
# Language: set a code (e.g. en) to force one language.
# Leave empty to send language_detection=true (AssemblyAI detects the language automatically).
ASSEMBLYAI_LANGUAGE_CODE=
# Optional: exact number of speakers, only if certain (e.g. 2). Leave empty otherwise.
ASSEMBLYAI_SPEAKERS_EXPECTED=
# How long to wait for a transcript before giving up (seconds)
TRANSCRIPTION_TIMEOUT_SECONDS=180

# OpenRouter (task extraction)
OPENROUTER_API_KEY=
# Must support structured outputs (json_schema). Team choice: deepseek/deepseek-v4-flash-0731 (not yet live-tested).
# Live-tested and working on 20 Oct 2026: openai/gpt-oss-20b
OPENROUTER_MODEL=
EXTRACTION_TIMEOUT_SECONDS=60
