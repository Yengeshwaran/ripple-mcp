# Ripple voice service — copy to .env and fill in. Never commit .env.

# Server
VOICE_SERVICE_PORT=8002

# Upload limits (agree these with Member 2)
MAX_UPLOAD_MB=25

# AssemblyAI (transcription + speaker diarization)
ASSEMBLYAI_API_KEY=
# Optional: force a language (e.g. en). Leave empty for automatic detection.
ASSEMBLYAI_LANGUAGE_CODE=
# Optional: expected number of speakers in the demo recording (e.g. 2). Leave empty if unsure.
ASSEMBLYAI_SPEAKERS_EXPECTED=
# How long to wait for a transcript before giving up (seconds)
TRANSCRIPTION_TIMEOUT_SECONDS=180

# OpenRouter (task extraction)
OPENROUTER_API_KEY=
# Pick a low-cost model that supports structured outputs (json_schema). Verify on openrouter.ai/models before use.
OPENROUTER_MODEL=
EXTRACTION_TIMEOUT_SECONDS=60
